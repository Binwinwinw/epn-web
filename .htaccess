# Configuration Apache pour l'application EPN

RewriteEngine On
RewriteBase /epn-web/

# Blocage immédiat des chemins sensibles et des fichiers de configuration
RewriteCond %{REQUEST_URI} ^/bin(?:/|$) [NC,OR]
RewriteCond %{REQUEST_URI} ^/src(?:/|$) [NC,OR]
RewriteCond %{REQUEST_URI} ^/database(?:/|$) [NC,OR]
RewriteCond %{REQUEST_URI} ^/(?:\.git|\.github|\.memory)(?:/|$) [NC,OR]
RewriteCond %{REQUEST_URI} ^/(?:\.env|\.env\..+|\.htaccess)$ [NC,OR]
RewriteCond %{REQUEST_URI} ^/.*\.(?:sql|log|ini)$ [NC]
RewriteRule ^ - [F,L]

# NE PAS rediriger les fichiers et répertoires réels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rediriger les requêtes vers public/ SAUF pour les chemins sensibles déjà bloqués ci-dessus
RewriteCond %{REQUEST_URI} !^/bin(?:/|$) [NC]
RewriteCond %{REQUEST_URI} !^/src(?:/|$) [NC]
RewriteCond %{REQUEST_URI} !^/database(?:/|$) [NC]
RewriteCond %{REQUEST_URI} !^/(?:\.git|\.github|\.memory)(?:/|$) [NC]
RewriteCond %{REQUEST_URI} !^/(?:\.env|\.env\..+|\.htaccess)$ [NC]
RewriteRule ^(.*)$ public/$1 [L]

# Configuration PHP
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300
php_value max_input_time 300

# Encodage UTF-8
AddDefaultCharset UTF-8

# Forcer l'environnement (décommentez pour forcer la production)
# SetEnv EPN_ENVIRONMENT production
# SetEnv EPN_ENVIRONMENT local
