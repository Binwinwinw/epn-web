# ============================================
# EPN Web - Configuration d'environnement
# ============================================
# Copier ce fichier en .env.local et .env.production
# et remplir les valeurs réelles

# Mode debug (true en développement, false en production)
DEBUG=true

# Base de données
DB_HOST=localhost
DB_NAME=epn_gestion
DB_USER=root
DB_PASS=

# Charset
DB_CHARSET=utf8mb4

# Site par défaut (BAC ou MAC)
DEFAULT_SITE=BAC

# Authentification (à implémenter)
# Format: username:password_hash (générer avec password_hash())
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# Session
SESSION_NAME=epn_web_session
SESSION_COOKIE_HTTPONLY=1
SESSION_USE_ONLY_COOKIES=1

# Sécurité CORS (si nécessaire)
ALLOWED_ORIGINS=http://localhost

